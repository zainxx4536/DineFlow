<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dineflow.mapper.AddressBookMapper">

    <select id="selectForUpdate" resultType="com.dineflow.entity.AddressBook">
        select *
        from address_book
        where id = #{addressBookId}
          and user_id = #{userId}
            for update
    </select>
</mapper>
